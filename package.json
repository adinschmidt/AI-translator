{
    "name": "ai-translator",
    "version": "0.9.2",
    "description": "Translate text and pages using customizable AI models.",
    "license": "AGPL-3.0",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "check:i18n": "bun run scripts/check-i18n.ts",
        "build": "bun run build.ts",
        "build:zip": "bun run build.ts --zip"
    },
    "devDependencies": {
        "@tailwindcss/cli": "4.3.3",
        "@types/chrome": "0.2.9",
        "bun-types": "1.4.2",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "4.0.53",
        "@ai-sdk/google": "4.0.69",
        "@ai-sdk/mistral": "4.0.43",
        "@ai-sdk/openai": "4.0.66",
        "@ai-sdk/xai": "4.0.58",
        "ai": "7.0.99",
        "dompurify": "3.4.15",
        "eld": "2.1.0"
    }
}
